<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
    <children>
        <VBox prefHeight="650.0" prefWidth="1000.0" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Label fx:id="lblMensagem" />

                <Label styleClass="title" text="Gerenciar Eletrônicos" />

                <TitledPane animated="false" text="Área de Cadastro">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label layoutX="14.0" layoutY="14.0" styleClass="form-label" text="ID" />
                                <TextField fx:id="txtId" editable="false" layoutX="14.0" layoutY="34.0" prefWidth="80.0" promptText="Cód." />

                                <Label layoutX="114.0" layoutY="14.0" styleClass="form-label" text="Nome" />
                                <TextField fx:id="txtNome" layoutX="114.0" layoutY="34.0" prefWidth="180.0" promptText="Ex: Smartphone" />

                                <Label layoutX="314.0" layoutY="14.0" styleClass="form-label" text="Modelo" />
                                <TextField fx:id="txtModelo" layoutX="314.0" layoutY="34.0" prefWidth="180.0" promptText="Ex: Galaxy S23" />

                                <Label layoutX="514.0" layoutY="14.0" styleClass="form-label" text="Cor" />
                                <ComboBox fx:id="cbxCor" layoutX="514.0" layoutY="34.0" prefWidth="120.0" />

                                <Button fx:id="btnSalvar" layoutX="660.0" layoutY="34.0" mnemonicParsing="false" onAction="#btnSalvarAction" styleClass="btn-primary" text="Salvar" />
                                <Button fx:id="btnAtualizar" disable="true" layoutX="730.0" layoutY="34.0" mnemonicParsing="false" onAction="#btnAtualizarAction" styleClass="btn-secondary" text="Atualizar" />
                                <Button fx:id="btnExcluir" disable="true" layoutX="810.0" layoutY="34.0" mnemonicParsing="false" onAction="#btnExcluirAction" styleClass="btn-danger" text="Excluir" />
                                <Button fx:id="btnLimpar" layoutX="880.0" layoutY="34.0" mnemonicParsing="false" onAction="#btnLimparAction" styleClass="btn-secondary" text="Limpar" />
                            </children>
                        </AnchorPane>
                    </content>
                </TitledPane>

                <TitledPane animated="false" text="Lista de Eletrônicos" VBox.vgrow="ALWAYS">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <TableView fx:id="tblEletronico" onMouseClicked="#carregarCampos" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <columns>
                                        <TableColumn fx:id="colId" maxWidth="100.0" minWidth="80.0" prefWidth="80.0" text="ID" />
                                        <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome" />
                                        <TableColumn fx:id="colModelo" prefWidth="200.0" text="Modelo" />
                                        <TableColumn fx:id="colCor" prefWidth="200.0" text="Cor" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </TitledPane>

            </children>
        </VBox>
    </children>
</AnchorPane>
