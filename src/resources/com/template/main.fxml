<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <Label styleClass="title" text="Gerenciar Eletrônicos" />

                <HBox spacing="20.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="form-label" text="ID" />
                                <TextField fx:id="txtId" prefWidth="100.0" promptText="Cód." />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Nome" />
                                <TextField fx:id="txtNome" promptText="Ex: Smartphone" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Cor" />
                                <TextField fx:id="txtCor" promptText="Ex: Preto" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" text="Modelo" />
                                <TextField fx:id="txtModelo" promptText="Ex: Galaxy S23" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#btnSalvarAction" styleClass="btn-primary" text="Salvar" />
                        <Button fx:id="bntEditar" mnemonicParsing="false" onAction="#btnEditarAction" styleClass="btn-secondary" text="Editar" />
                        <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#btnAtualizarAction" styleClass="btn-secondary" text="Atualizar" />
                        <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#btnExcluirAction" styleClass="btn-danger" text="Excluir" />
                    </children>
                </HBox>

                <TableView fx:id="tblEletronico" onMouseClicked="#carregarCampos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="100.0" minWidth="80.0" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome" />
                        <TableColumn fx:id="colModelo" prefWidth="200.0" text="Modelo" />
                        <TableColumn fx:id="colCor" prefWidth="200.0" text="Cor" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </children>
</AnchorPane>
